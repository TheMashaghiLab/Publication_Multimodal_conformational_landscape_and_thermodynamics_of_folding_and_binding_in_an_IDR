# vim: ft=plumed

####################################
#  >> 1nov native contacts between chains <<
####################################


#generated with gmx editconf -f topol.tpr -o reference.pdb,see https://www.plumed.org/doc-v2.7/user-doc/html/_m_o_l_i_n_f_o.html
MOLINFO MOLTYPE=protein STRUCTURE=fcp1.pdb
WHOLEMOLECULES ENTITY0=1-294

# Define CVs

ene: ENERGY

#redisues in helical conforamtion
alpha: ALPHARMSD RESIDUES=941-960 TYPE=DRMSD R_0=0.08 NN=8 MM=12 

#Native in helix
cmap_hel: CONTACTMAP ATOMS1=42,81 ATOMS2=57,96 ATOMS3=67,113 ATOMS4=79,123 ATOMS5=94,145 ATOMS6=111,155 ATOMS7=121,174 ATOMS8=143,189 ATOMS9=153,199 ATOMS10=172,214 ATOMS11=31,69 ATOMS12=187,233 ATOMS13=197,247 ATOMS14=212,259 SWITCH={RATIONAL R_0=0.3 NN=6 MM=8}

cmap_hel_sum: CONTACTMAP ATOMS1=42,81 ATOMS2=57,96 ATOMS3=67,113 ATOMS4=79,123 ATOMS5=94,145 ATOMS6=111,155 ATOMS7=121,174 ATOMS8=143,189 ATOMS9=153,199 ATOMS10=172,214 ATOMS11=31,69 ATOMS12=187,233 ATOMS13=197,247 ATOMS14=212,259 SWITCH={RATIONAL R_0=0.3 NN=6 MM=8} WEIGHT=0.071428571 SUM

rg: GYRATION TYPE=RADIUS ATOMS=5,12,23,34,45,60,70,82,97,114,124,146,156,175,190,200,215,234,248,260,279

## alpha RMSD
main_hel_sum: CONTACTMAP ATOMS1=42,81 ATOMS2=57,96 ATOMS3=67,113 ATOMS4=79,123 ATOMS5=94,145 ATOMS6=111,155 ATOMS7=121,174 ATOMS8=143,189 ATOMS9=153,199 ATOMS10=172,214 ATOMS11=187,233 SWITCH={RATIONAL R_0=0.3 NN=6 MM=8} SUM


OPES_METAD ...
  LABEL=opes1
  ARG=alpha
  FILE=Kernels1.data
  STATE_RFILE=compressed1.Kernels
  STATE_WFILE=compressed1.Kernels
  PACE=100000
  TEMP=300
  BARRIER=10
  SIGMA=0.015
  UPDATE_FROM=0
  RESTART=NO
... OPES_METAD

ecv: ECV_MULTITHERMAL ARG=ene TEMP_MIN=300 TEMP_MAX=373
opesX: OPES_EXPANDED ARG=ecv.* FILE=DeltaFs.data PACE=1000 UPDATE_FROM=0

# PRINT
PRINT STRIDE=1000 ARG=opes1.*,opesX.*,ene,alpha,rg,cmap_hel_sum,main_hel_sum FILE=COLVAR
ENDPLUMED

